        "jsCode": "// ============================================\n// BRIGHTPATH CONSULTING\n// HOT LEAD EMAIL - MANUAL REVIEW\n// ============================================\n\n// The email failed one or more validation checks.\n// DO NOT send it automatically.\n\n// Get the validation error\nconst validationError = $json.validation_error || 'Unknown validation error';\n\n// Create a clean review status\nconst reviewStatus = 'Review Required';\n\n// Return the lead information plus the review details\nreturn {\n  json: {\n    lead_id: $json.lead_id,\n    submittedAt: $json.submittedAt,\n\n    name: $json.name,\n    email: $json.email,\n    company: $json.company,\n\n    budget: $json.budget,\n    urgency: $json.urgency,\n    service: $json.service,\n\n    score: $json.total_score,\n    category: $json.category,\n\n    email_status: reviewStatus,\n\n    validation_error: validationError,\n\n    generated_email: $json.cleaned_email || '',\n\n    review_required: true\n  }\n};"
