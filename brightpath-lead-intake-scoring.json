      "id": "88398d77-afbf-4158-8701-09fb38c9885d",
      "name": "Google Gemini Chat Model1"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a personalized follow-up email using the following lead information.\n\nLead name:\n{{ $('Edit Fields1').item.json.name }}\n\nCompany:\n{{ $json.Company }}\n\nEmail:\n{{ $json.Email }}\n\nDescription:\n{{ $('Edit Fields1').item.json.description }}\n\nUse only the information provided above.\n\nThe approved company signature is:\n\nBest,\nMarcus Bright\nFounder, Brightpath Consulting",
        "messages": {
          "messageValues": [
            {
              "message": "You are the lead follow-up email writer for Brightpath Consulting.  Your job is to write a short, natural, personalized first-response email to a new high-priority business lead.  Follow these rules strictly:  1. Write like a real founder or consultant, not like an AI assistant. 2. Keep the email concise. Aim for approximately 80–130 words. 3. Address the lead by their first name when possible. 4. Mention the service they asked about naturally. 5. Use one relevant detail from their description when one is available. 6. Do not mention the lead's budget, lead score, or Hot/Warm/Cold classification. 7. Do not invent facts about the lead, their company, their systems, their problems, or their business. 8. Do not invent pricing, guarantees, services, results, partnerships, or claims. 9. Do not say that you reviewed anything that was not actually provided. 10. Do not use exaggerated sales language. 11. Do not use phrases such as \"I hope this email finds you well\", \"I am thrilled\", \"exciting opportunity\", or other generic AI-sounding phrases. 12. Ask for a short 15-minute conversation. 13. Keep the tone professional, warm, direct, and human. 14. Use the approved signature exactly as provided. 15. Return ONLY the email body. Do not return analysis, explanations, JSON, markdown, or a subject line."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -1632,
        -80
      ],
      "id": "d93ff3c9-7599-42b2-be1c-63c8f28c1698",
      "name": "Generate hot lead email"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ============================================\n// BRIGHTPATH CONSULTING\n// HOT LEAD EMAIL VALIDATION & CLEANUP\n// ============================================\n\n// Gemini's response from the Basic LLM Chain\nlet emailBody = $json.text;\n\n// Make sure we actually received a response\nif (typeof emailBody !== 'string' || emailBody.trim() === '') {\n  return {\n    json: {\n      ...$json,\n      email_valid: false,\n      email_status: 'Review Required',\n      validation_error: 'Gemini returned an empty response.',\n      cleaned_email: ''\n    }\n  };\n}\n\n\n// ============================================\n// 1. CLEAN GEMINI OUTPUT\n// ============================================\n\n// Remove leading/trailing whitespace\nemailBody = emailBody.trim();\n\n// Convert literal \\n characters into real line breaks\nemailBody = emailBody.replace(/\\\\n/g, '\\n');\n\n// Remove markdown code fences if Gemini adds them\nemailBody = emailBody.replace(/^```(?:text|markdown)?\\s*/i, '');\nemailBody = emailBody.replace(/\\s*```$/i, '');\n\n// Remove accidental \"Subject:\" line if Gemini returns one\nemailBody = emailBody.replace(/^Subject:.*\\n+/i, '');\n\n// Clean excessive blank lines\nemailBody = emailBody.replace(/\\n{3,}/g, '\\n\\n');\n\n// Trim again after cleanup\nemailBody = emailBody.trim();\n\n\n// ============================================\n// 2. BASIC QUALITY CHECKS\n// ============================================\n\nconst errors = [];\n\n\n// Check minimum length\nif (emailBody.length < 80) {\n  errors.push('Email is too short.');\n}\n\n\n// Check maximum length\nif (emailBody.length > 1500) {\n  errors.push('Email is unusually long.');\n}\n\n\n// ============================================\n// 3. CHECK FOR REQUIRED SIGNATURE\n// ============================================\n\nif (!emailBody.includes('Marcus Bright')) {\n  errors.push('Marcus Bright signature is missing.');\n}\n\nif (!emailBody.includes('Founder, Brightpath Consulting')) {\n  errors.push('Company signature is missing.');\n}\n\n\n// ============================================\n// 4. CHECK FOR INTERNAL INFORMATION\n// ============================================\n\n// Gemini should never expose our internal lead scoring system.\n\nconst forbiddenTerms = [\n  'hot lead',\n  'warm lead',\n  'cold lead',\n  'lead score',\n  'score: 90',\n  'score:',\n  'lead category',\n  'internal score'\n];\n\nconst lowerEmail = emailBody.toLowerCase();\n\nfor (const term of forbiddenTerms) {\n  if (lowerEmail.includes(term.toLowerCase())) {\n    errors.push(`Internal information detected: \"${term}\".`);\n  }\n}\n\n\n// ============================================\n// 5. CHECK FOR AI/TECHNICAL OUTPUT\n// ============================================\n\n// These are signs Gemini may have returned something\n// other than a normal email.\n\nconst technicalPatterns = [\n  '```',\n  '\"email\":',\n  '\"subject\":',\n  '\"body\":',\n  'here is the email',\n  'here\\'s the email',\n  'sure, here',\n  'as an ai'\n];\n\nfor (const pattern of technicalPatterns) {\n  if (lowerEmail.includes(pattern.toLowerCase())) {\n    errors.push(`Unexpected AI/technical output detected: \"${pattern}\".`);\n  }\n}\n\n\n// ============================================\n// 6. CHECK FOR PLACEHOLDER TEXT\n// ============================================\n\nconst placeholders = [\n  '[name]',\n  '[company]',\n  '[service]',\n  '[description]',\n  '[your name]',\n  '[insert',\n  '<name>',\n  '<company>',\n  '<service>'\n];\n\nfor (const placeholder of placeholders) {\n  if (lowerEmail.includes(placeholder.toLowerCase())) {\n    errors.push(`Placeholder text detected: \"${placeholder}\".`);\n  }\n}\n\n\n// ============================================\n// 7. FINAL VALIDATION RESULT\n// ============================================\n\nconst emailValid = errors.length === 0;\n\nlet emailStatus;\n\nif (emailValid) {\n  emailStatus = 'Ready to Send';\n} else {\n  emailStatus = 'Review Required';\n}\n\n\n// ============================================\n// 8. RETURN RESULT\n// ============================================\n\nreturn {\n  json: {\n    ...$json,\n\n    cleaned_email: emailBody,\n\n    email_valid: emailValid,\n\n    email_status: emailStatus,\n\n    validation_error: errors.length > 0\n      ? errors.join(' ')\n      : ''\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
