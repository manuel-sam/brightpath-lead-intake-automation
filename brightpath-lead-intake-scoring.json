    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ============================================\n// BRIGHTPATH CONSULTING - LEAD SCORING\n// ============================================\n\n// Get the data from the Edit Fields node\nconst lead = $json;\n\n// --------------------------------------------\n// 1. READ LEAD INFORMATION\n// --------------------------------------------\n\nconst name = lead.name;\nconst email = lead.email;\nconst company = lead.company;\nconst budget = lead.budget;\nconst urgency = lead.urgency;\nconst service = lead.service;\nconst description = lead.description;\nconst submittedAt = lead.submittedAt;\n\n// Keep the existing Lead ID if available.\n// If it doesn't exist, create one.\nconst leadId = lead.lead_id || `BP-${Date.now()}`;\n\n\n// --------------------------------------------\n// 2. SCORE THE BUDGET\n// --------------------------------------------\n\nlet budgetScore = 0;\n\nswitch (budget) {\n\n  case 'Under $2,000':\n    budgetScore = 10;\n    break;\n\n  case '$2,000 – $4,999':\n    budgetScore = 20;\n    break;\n\n  case '$5,000 – $9,999':\n    budgetScore = 35;\n    break;\n\n  case '$10,000 – $19,999':\n    budgetScore = 50;\n    break;\n\n  case '$20,000+':\n    budgetScore = 60;\n    break;\n\n  case 'Not sure':\n    budgetScore = 5;\n    break;\n\n  default:\n    budgetScore = 0;\n}\n\n\n// --------------------------------------------\n// 3. SCORE THE URGENCY\n// --------------------------------------------\n\nlet urgencyScore = 0;\n\nswitch (urgency) {\n\n  case 'ASAP / Within 2 weeks':\n    urgencyScore = 40;\n    break;\n\n  case 'Within 30 days':\n    urgencyScore = 30;\n    break;\n\n  case '1–3 months':\n    urgencyScore = 15;\n    break;\n\n  case 'Just exploring':\n    urgencyScore = 5;\n    break;\n\n  default:\n    urgencyScore = 0;\n}\n\n\n// --------------------------------------------\n// 4. CALCULATE TOTAL SCORE\n// --------------------------------------------\n\nconst totalScore = budgetScore + urgencyScore;\n\n\n// --------------------------------------------\n// 5. DETERMINE LEAD CATEGORY\n// --------------------------------------------\n\nlet category;\n\nif (totalScore >= 70) {\n  category = 'Hot';\n} else if (totalScore >= 40) {\n  category = 'Warm';\n} else {\n  category = 'Cold';\n}\n\n\n// --------------------------------------------\n// 6. CREATE EMAIL STATUS\n// --------------------------------------------\n\n// Only Hot leads should enter the AI email process.\n\nlet emailStatus;\n\nif (category === 'Hot') {\n  emailStatus = 'Pending AI Email';\n} else {\n  emailStatus = 'Not Required';\n}\n\n\n// --------------------------------------------\n// 7. RETURN CLEAN OUTPUT\n// --------------------------------------------\n\nreturn {\n  json: {\n    lead_id: leadId,\n    submittedAt: submittedAt,\n\n    name: name,\n    email: email,\n    company: company,\n\n    budget: budget,\n    budget_score: budgetScore,\n\n    urgency: urgency,\n    urgency_score: urgencyScore,\n\n    service: service,\n    description: description,\n\n    total_score: totalScore,\n    category: category,\n\n    email_status: emailStatus,\n\n    email_sent_at: '',\n    error_review_note: ''\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
